# ==============================================================
# TaskFlow - Environment Configuration Variables
# ==============================================================
# Port for the Express server to listen on
PORT=5000

# MongoDB Connection String (Local MongoDB instance or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow_db

# Secret key used to sign and verify JSON Web Tokens (JWT)
# Use a strong, random string in production
JWT_SECRET=taskflow_jwt_secret_key_2026_mca_project

# Token expiration time (e.g., '1h', '24h', '7d')
JWT_EXPIRES_IN=7d

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (Cross-Origin Resource Sharing)
FRONTEND_URL=http://localhost:5173

